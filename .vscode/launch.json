{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug TestAPIKeyCalling",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TestAPIKeyCalling",
      "program": "${workspaceFolder}/bin/Debug/net10.0/TestAPIKeyCalling.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "launchSettingsProfile": "",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5277"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "checkForDevCert": false
    }
  ]
}
